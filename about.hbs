<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Third-party licenses of s3-inventory-bill</title>
</head>
<body>
<h1>Third-party licenses</h1>
<p>The s3-inventory-bill binary contains the Rust crates listed here. Each license text follows its list of crates.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>License texts</h2>
{{#each licenses}}
<section id="{{id}}">
<h3>{{name}}</h3>
<ul>
{{#each used_by}}
<li>{{crate.name}} {{crate.version}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
</section>
{{/each}}
</body>
</html>
